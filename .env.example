# Create a separate Supabase project for the Airport Employee Community Platform.
# These browser-safe values are available in Supabase under Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: the app otherwise uses the key-free OpenFreeMap Liberty style.
# VITE_MAP_STYLE_URL=https://your-map-provider.example/style.json
